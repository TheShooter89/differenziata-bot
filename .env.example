# Telegram credentials for differenziata-bot.
#
# Copy to .env and fill in:  cp .env.example .env   (mode 600, gitignored)
#
# TELEGRAM_TOKEN   the bot token from @BotFather
# TELEGRAM_CHAT_ID your user id, or a group id (negative for groups)
#
# Both can also be set as real environment variables, which take precedence over
# this file:
#   TELEGRAM_TOKEN=... bin/differenziata-bot --test-send

TELEGRAM_TOKEN=000000000:REPLACE_WITH_YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=REPLACE_WITH_YOUR_CHAT_ID